# Copiar a .env y completar.

SITE_NAME=textboard
PORT=3000
BASE_URL=http://localhost:3000

# Obligatorio en producción. Firma los IDs anónimos y los tokens CSRF:
# si cambia, los IDs de todos los hilos cambian. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Login con Google. Se crea en console.cloud.google.com → APIs y servicios → Credenciales →
# Crear credenciales → ID de cliente de OAuth → Aplicación web. URI de redireccionamiento autorizado:
#   http://localhost:3000/auth/google/callback   (y el del dominio real en producción)
# Sin estas dos, en desarrollo /entrar ofrece un acceso de prueba; en producción el server no arranca.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos de Google que entran como admin, separados por coma. El correo no se guarda en la base.
ADMIN_EMAILS=

# Filtro de moderación (Claude). Sin clave, todo mensaje va a revisión humana.
ANTHROPIC_API_KEY=

# Opcional
DB_PATH=data/textboard.db
TZ_SITIO=America/Argentina/Buenos_Aires

# Opcional: cápsula Gemini de solo lectura. Certificado y clave en PEM (con \n en vez de saltos de
# línea si van en una sola línea). Generar uno de larga duración, por ejemplo:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
#     -subj "/CN=tu.dominio" -keyout key.pem -out cert.pem
GEMINI_CERT=
GEMINI_KEY=
GEMINI_PORT=1965
# Hosts que la cápsula atiende, separados por coma (vacío = cualquiera).
GEMINI_HOSTS=
# Dirección pública que se muestra en /texto, p. ej. gemini://tu.dominio
GEMINI_URL=

# Opcional: link "Código fuente" en el pie (la AGPL pide ofrecerlo a quien usa el servicio).
CODIGO_URL=
